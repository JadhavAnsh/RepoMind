# RepoMind monorepo environment template. Placeholders only - copy to .env
# (git-ignored) and fill in real values. Never commit real secrets.

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/repomind

# Ports (web = 3000, api = 4000, retrieval = 8000)
PORT=4000
WEB_PORT=3000
RETRIEVAL_PORT=8000

# Service URLs
RETRIEVAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI providers
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=your-llm-model
EMBEDDING_MODEL=your-embedding-model

# GitHub (optional personal access token for local development)
GITHUB_TOKEN=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
